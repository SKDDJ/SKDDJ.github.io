{% comment %}
  Override of al_folio_core 1.0.15 _includes/figure.liquid.
  Publication previews are passed loading="eager" and avoid_scaling=true.
  For class "preview", load lazily and allow the imagemagick WebP srcset.
  The about-page avatar does not use that class and stays eager.
{% endcomment %}
{% assign img_path = include.path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
{% assign parts = include.path | split: '.' %}
{% assign ext = parts.last %}
{% assign image_loading = include.loading %}
{% assign avoid_scaling = include.avoid_scaling %}
{% if include.class contains 'preview' %}
  {% assign image_loading = 'lazy' %}
  {% assign avoid_scaling = false %}
{% endif %}
{% assign alt_text = include.alt %}
{% if site.data.image_alts[include.alt] %}
  {% assign alt_text = site.data.image_alts[include.alt] %}
{% endif %}

<figure
  {% if include.slot %}
    slot="{{ include.slot }}"
  {% endif %}
>
  <picture>
    <!-- Auto scaling with imagemagick -->
    <!--
      See https://www.debugbear.com/blog/responsive-images#w-descriptors-and-the-sizes-attribute and
      https://developer.mozilla.org/en-US/docs/Learn/HTML/Multimedia_and_embedding/Responsive_images for info on defining 'sizes' for responsive images
    -->
    {% if site.imagemagick.enabled %}
      {% unless avoid_scaling %}
        <source
          class="responsive-img-srcset"
          {% if ext == 'gif' or ext == 'jpeg' or ext == 'jpg' or ext == 'png' or ext == 'tiff' %}
            srcset="{% for i in site.imagemagick.widths %}{{ img_path | relative_url }}-{{ i }}.webp {{ i }}w,{% endfor %}"
            type="image/webp"
          {% else %}
            srcset="{{ include.path | relative_url }}"
          {% endif %}
          {% if include.sizes %}
            sizes="{{ include.sizes }}"
          {% else %}
            sizes="95vw"
          {% endif %}
        >
      {% endunless %}
    {% endif %}
    <img
      src="{% if include.url %}{{ include.url }}{% elsif include.cache_bust %}{{ include.path | relative_url | bust_file_cache }}{% else %}{{ include.path | relative_url }}{% endif %}"
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      {% if include.width %}
        width="{{ include.width }}"
      {% else %}
        width="100%"
      {% endif %}
      {% if include.height %}
        height="{{ include.height }}"
      {% else %}
        height="auto"
      {% endif %}
      {% if include['min-width'] or include['min-height'] or include['max-width'] or include['max-height'] %}
        style="
          {% if include['min-width'] %}
            min-width: {{ include.min-width }};
          {% endif %}
          {% if include['min-height'] %}
            min-height: {{ include.min-height }};
          {% endif %}
          {% if include['max-width'] %}
            max-width: {{ include.max-width }};
          {% endif %}
          {% if include['max-height'] %}
            max-height: {{ include.max-height }};
          {% endif %}
        "
      {% endif %}
      {% if alt_text %}
        alt="{{ alt_text }}"
      {% endif %}
      {% if include.title %}
        title="{{ include.title }}"
      {% endif %}
      {% if include.zoomable %}
        data-zoomable
      {% endif %}
      {% if image_loading %}
        loading="{{ image_loading }}"
      {% elsif site.lazy_loading_images %}
        loading="lazy"
      {% endif %}
      onerror="this.onerror=null; document.querySelectorAll('.responsive-img-srcset').forEach(function (n) { n.remove(); });"
    >
  </picture>

  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
