{% comment %}
  _includes/cv/org_logo.liquid
  Left-column mark for a CV entry.
  `logo` is a filename in assets/img/cv_logos/, or an absolute URL.
{% endcomment %}
{% if include.entry.logo %}
  {% assign logo_file = include.entry.logo | strip %}
  {% if logo_file contains '://' or logo_file contains '/' %}
    {% assign logo_src = logo_file %}
  {% else %}
    {% assign logo_src = logo_file | prepend: '/assets/img/cv_logos/' %}
  {% endif %}
  {% capture logo_alt %}
    {% if include.entry.company %}{{ include.entry.company }}{% elsif include.entry.institution %}{{ include.entry.institution }}{% elsif include.entry.organization %}{{ include.entry.organization }}{% elsif include.entry.name %}{{ include.entry.name }}{% endif %}
  {% endcapture %}
  <img class="cv-org-logo" src="{{ logo_src | relative_url }}" alt="{{ logo_alt | strip }}" loading="lazy" decoding="async">
{% endif %}
